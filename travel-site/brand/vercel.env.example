# Import into Vercel: Settings > Environment Variables > Import .env (or paste into the Key field).
# FIRST replace every value in CAPITALS / XXXX below with your real details. Keep the single quotes and the commas.
# whatsapp = digits only with country code (919876543210). udyam = your number, or leave "".
# legal_reviewed: change false to true ONLY after you have read the Terms, Refunds and Privacy pages. The build refuses to publish while it is false or while a value is a placeholder.
# These are public site details (they appear on the website), never keys or passwords.
BRAND_JSON='{"brand":"GhumoCo","domain":"ghumoco-travel-phi.vercel.app","whatsapp":"91XXXXXXXXXX","phone":"+91 XXXXX XXXXX","instagram":"YOUR_INSTAGRAM_HANDLE","founder":"YOUR NAME","udyam":"","api_base":"","legal_name":"YOUR FULL LEGAL NAME","email":"YOUR EMAIL","address":"YOUR CITY, STATE","legal_reviewed":false}'
